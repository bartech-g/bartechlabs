# SMTP settings for the contact form (nuxt-nodemailer)
NUXT_NODEMAILER_FROM="Bartech Labs <hello@bartechlabs.com>"
NUXT_NODEMAILER_HOST=smtp.example.com
NUXT_NODEMAILER_PORT=465
NUXT_NODEMAILER_SECURE=true
NUXT_NODEMAILER_AUTH_USER=
NUXT_NODEMAILER_AUTH_PASS=

# Where contact form messages are delivered
NUXT_CONTACT_TO=hello@bartechlabs.com
